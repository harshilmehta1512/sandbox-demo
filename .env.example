# ── MAIA MUSE Sandbox — Environment Variables ──────────────────────────────

# Server port (default: 3001)
PORT=3001

# Model mode:
#   demo  → deterministic mock data, no GPU needed (default)
#   gpu   → forwards requests to the Azure inference server
MAIA_MODEL_MODE=demo

# GPU inference server endpoint (only used when MAIA_MODEL_MODE=gpu)
# Run SSH tunnel first: ssh -i ~/Desktop/SS/HAMAD_IDE.pem -p 50000 -L 8001:localhost:8001 azureuser@<YOUR_VM_IP> -N
MAIA_MODEL_ENDPOINT=http://localhost:8001
